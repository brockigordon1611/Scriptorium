# Local Claude Code settings
.claude/settings.local.json

# Version backups
Backup of versions/

# STEPBible raw data files (large, re-downloadable)
scripts/stepbible/*.txt
scripts/stepbible/*.csv

# Vite build output
dist/
node_modules/
package-lock.json

# Secrets
.env
.env.local
.env.*.local

# Temporary patch scripts
patch_app.js
patch_app.cjs
patch_audio.cjs

# Audio timestamp JSONs — large, only needed for Android/iOS builds, generated locally
public/timestamps/

# The android/ and ios/ projects are versioned: they hold the app's native
# settings. Their build output is ignored by their own .gitignore files.

# macOS junk
.DS_Store
**/.DS_Store

# iCloud conflict copies — the project lives on an iCloud-synced Desktop,
# so Finder drops "<name> 2.ext" duplicates next to files it can't merge.
# Matches the exact convention: a space, then digits, before the extension.
* [0-9].*
* [0-9][0-9].*
* [0-9]/
* [0-9][0-9]/

# Claude Code worktrees
.claude/worktrees/
