{
  "appId": "com.brockgordon.scriptorium",
  "appName": "Scriptorium",
  "webDir": "dist",
  "ios": {
    "webContentsDebuggingEnabled": false,
    "scheme": "Scriptorium TR"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2500,
      "backgroundColor": "#0e0d0b",
      "showSpinner": false,
      "useDialog": false
    }
  }
}
